{
  "inputs": [
    {
      "type": "promptString",
      "id": "radzen-key",
      "description": "Radzen Blazor MCP license key",
      "password": true
    }
  ],
  "servers": {
    "radzen-blazor": {
      "type": "http",
      "url": "https://app.radzen.com/mcp",
      "headers": {
        "X-Radzen-Key": "${input:radzen-key}"
      }
    }
  }
}
