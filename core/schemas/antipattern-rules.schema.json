{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anti-pattern rules",
  "type": "object",
  "required": [
    "schemaVersion",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "severity",
          "category",
          "detection",
          "principles",
          "doc",
          "why",
          "fix"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AP-[A-Z0-9]+-[0-9]{2}$"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "category": {
            "type": "string"
          },
          "detection": {
            "enum": [
              "regex",
              "absence",
              "manual-review",
              "tool"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pattern": {
            "type": "string"
          },
          "requires": {
            "type": "string"
          },
          "unless": {
            "type": "string"
          },
          "unlessInFile": {
            "type": "string"
          },
          "multiline": {
            "type": "boolean"
          },
          "principles": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^P-[0-9]{2}$"
            }
          },
          "doc": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "bad": {
            "type": "string"
          },
          "good": {
            "type": "string"
          },
          "mcpQuery": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "excludeTests": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "detection": {
                  "const": "regex"
                }
              }
            },
            "then": {
              "required": [
                "files",
                "pattern"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "detection": {
                  "const": "absence"
                }
              }
            },
            "then": {
              "required": [
                "files",
                "pattern",
                "requires"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    }
  }
}
