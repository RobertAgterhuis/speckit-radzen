{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP evidence log",
  "type": "object",
  "required": ["schemaVersion", "feature", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "feature": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "at", "component", "members", "question", "source", "rank", "summary", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^MCP-[0-9]{3}$" },
          "at": { "type": "string" },
          "component": { "type": "string", "minLength": 1 },
          "members": { "type": "array", "items": { "type": "string" } },
          "question": { "type": "string", "minLength": 1 },
          "query": { "type": ["string", "null"] },
          "source": { "enum": ["compiler", "project", "mcp", "docs", "model"] },
          "rank": { "type": "integer", "minimum": 1, "maximum": 5 },
          "server": { "type": ["string", "null"] },
          "tool": { "type": ["string", "null"] },
          "summary": { "type": "string", "minLength": 1 },
          "radzenVersion": { "type": ["string", "null"] },
          "projectEvidence": { "type": "array", "items": { "type": "string" } },
          "compileVerified": { "type": "boolean" },
          "fallbackApproved": { "type": "boolean" },
          "fallbackReason": { "type": ["string", "null"] },
          "status": { "enum": ["confirmed", "conflict", "superseded"] },
          "supersedes": { "type": ["string", "null"] }
        }
      }
    }
  }
}
